{
  "name": "journey-sharing-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "mobile:sync": "node scripts/api-config.mjs check && bun run build && bunx --bun cap sync",
    "mobile:android": "bun run mobile:sync && bunx --bun cap open android",
    "mobile:ios": "bun run mobile:sync && bunx --bun cap open ios",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "bun@1.4.3",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor/android": "^8",
    "@capacitor/core": "^8",
    "@capacitor/geolocation": "^8",
    "@capacitor/ios": "^8",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8",
    "@types/leaflet": "^1.9.22",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
